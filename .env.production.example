# Production settings. Copy to .env.production on the server and fill in every value.
# Never commit .env.production.

# ---- Website ----------------------------------------------------------------------------------
# The public address, exactly as people type it (https, no trailing slash).
APP_CORS_ORIGINS=https://assessment.cftools.live
WEB_PORT=80

# ---- Database (PostgreSQL) ----------------------------------------------------------------
# With the "db" container in docker-compose, keep DB_HOST=db and DB_PORT=5432.
# For an external PostgreSQL server, set DB_HOST/DB_PORT to that server instead.
# The app connects to: jdbc:postgresql://DB_HOST:DB_PORT/DB_NAME
DB_HOST=db
DB_PORT=5432
DB_NAME=assessment
DB_USER=assessment
DB_PASSWORD=<long random password>

# ---- Microsoft sign-in (Azure app registration) -----------------------------------------------
AZURE_TENANT_ID=<Directory (tenant) ID>
AZURE_CLIENT_ID=<Application (client) ID>
APP_ALLOWED_DOMAINS=cloudfuze.com

# ---- Security and admins ----------------------------------------------------------------------
APP_JWT_SECRET=<random, 32+ characters>
# Used only to fill the admin list the very first time; after that admins live in the database.
APP_ADMIN_EMAILS=aditya.rompella@cloudfuze.com,sujana.manapuram@cloudfuze.com

# ---- OpenAI -----------------------------------------------------------------------------------
OPENAI_API_KEY=<key>
OPENAI_SCORING_MODEL=gpt-4o
OPENAI_MEETING_MODEL=gpt-realtime

# ---- Marks per part (total 100) ---------------------------------------------------------------
APP_MARKS_TEAMS=20
APP_MARKS_EMAIL=35
APP_MARKS_MEETING=45
