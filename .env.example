# Copy to .env and fill in. .env is gitignored; never commit real values.

# ---- Database (PostgreSQL) ----------------------------------------------------------------
# With the "db" container in docker-compose, keep DB_HOST=db and DB_PORT=5432.
# For an external PostgreSQL server, set DB_HOST/DB_PORT to that server instead.
# The app connects to: jdbc:postgresql://DB_HOST:DB_PORT/DB_NAME
DB_HOST=db
DB_PORT=5432
DB_NAME=assessment
DB_USER=assessment
DB_PASSWORD=assessment

# ---- Sign-in, admins, AI ----------------------------------------------------------------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# A random string of at least 32 characters.
APP_JWT_SECRET=
# Comma-separated admin emails.
APP_ADMIN_EMAILS=
APP_ALLOWED_DOMAINS=cloudfuze.com
APP_CORS_ORIGINS=http://localhost:5185
# Marks per part (the total is always scaled to 100).
APP_MARKS_TEAMS=20
APP_MARKS_EMAIL=35
APP_MARKS_MEETING=45
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
